name: adversarial-campaign

on:
  push:
  pull_request:

jobs:
  campaign:
    runs-on: ubuntu-latest
    env:
      PYTHONHASHSEED: "0"
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: "3.12"
      - name: Adversarial campaign (all tests must pass)
        run: python -I campaign.py --out campaign-ci
      - name: Reproducibility (published hashes must be reproduced)
        run: python -I campaign.py --verify campaign/results.json
      - uses: actions/upload-artifact@v4
        with:
          name: campaign-results
          path: campaign-ci/
